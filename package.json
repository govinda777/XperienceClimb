{
  "name": "xperience-climb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --passWithNoTests --silent --watchAll=false --testPathIgnorePatterns=integration",
    "test:pre-commit": "jest --passWithNoTests --silent --watchAll=false --testPathIgnorePatterns=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:destinations:unit": "jest src/themes/__tests__/destinations-images.test.tsx --watchAll=false",
    "test:destinations:e2e": "playwright test tests/e2e/destinations-images.spec.ts",
    "test:destinations": "npm run test:destinations:unit && npm run test:destinations:e2e",
    "create-tour": "node scripts/create-tour.js",
    "create-theme": "node scripts/create-theme-with-external-images.js",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "pipeline:quick": "npm run type-check && npm run test:unit",
    "pipeline": "npm run type-check && npm run lint && npm run test:unit && npm run build && npm run test:e2e"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.27.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.7",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.21.19",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "react-native": "0.76.0"
  }
}
